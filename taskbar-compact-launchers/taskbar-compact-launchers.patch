+    // Read as a dependency so a TaskList.layoutEpoch bump re-evaluates EVERY
+    // delegate's cell in the same pass after a model/registration storm. During
+    // such storms (drag reorder, window open/close, launcher registration
+    // ramp) delegates evaluate their cells against different snapshots of
+    // (launcherCount, count, index), which can map two tasks onto one grid
+    // cell. GridLayout refuses the second item ("addItem ... cell already
+    // taken"), parks it at the next free cell -- row R, a THIRD stripe -- and
+    // never retries, so the bogus row persists until the next storm. A single
+    // post-storm re-evaluation of all cells in one layout pass resolves it.
+    // The row/column clamps below make the two-row constraint structural:
+    // even a transiently colliding cell cannot create a third stripe.
+    Layout.row: {
+        if (!explicitPlacement) {
+            return -1;
+        }
+        const R = rowCount;
+        const epoch = tasksRoot.taskList.layoutEpoch;
+        let row;
+        if (model.IsLauncher) {
+            row = index % R;
+        } else {
+            const L = tasksRoot.taskList.launcherCount;
+            const T = tasksRoot.taskList.count - L;
+            const taskCols = Math.max(1, Math.ceil(T / R));
