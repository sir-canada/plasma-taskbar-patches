+    // Drag-to-reorder: dragging an icon in the visible tray grid past the drag
+    // threshold engages a manual order. On release the full visible-order id list
+    // (with the dragged id spliced in at the target cell) is written to the
+    // "itemOrder" config key; the C++ SortedSystemTrayModel re-sorts accordingly.
+    // The handler takes a passive grab on press and only steals the exclusive grab
+    // from the regular MouseAreas once the threshold is exceeded, so clicks,
+    // wheel and press-and-hold behavior stay untouched.
+    DragHandler {
+        id: reorderHandler
+        enabled: abstractItem.inVisibleLayout
+        acceptedButtons: Qt.LeftButton
+        target: null
+        property point lastScenePos
+        onCentroidChanged: {
+            if (active) {
+                lastScenePos = centroid.scenePosition;
+            }
+        }
+        onActiveChanged: {
+            if (active) {
+                lastScenePos = centroid.scenePosition;
+            } else {
+                abstractItem.reorderDrop(lastScenePos);
+            }
+        }
+    }
+
+    // Floating copy of the dragged icon that follows the pointer during
+    // drag-to-reorder. Parented to the applet root with a high z so it is not
+    // affected by delegate clipping or the keyboard-navigation z-restacking of
+    // the grid delegates. Positioned with direct bindings (no animations).
+    ShaderEffectSource {
+        id: dragGhost
+        parent: root
+        z: 10000
+        visible: reorderHandler.active
+        sourceItem: reorderHandler.active ? iconContainer : null
+        width: iconContainer.width
+        height: iconContainer.height
+        opacity: 0.85
+        x: reorderHandler.active ? root.mapFromItem(null, reorderHandler.lastScenePos.x, reorderHandler.lastScenePos.y).x - width / 2 : 0
+        y: reorderHandler.active ? root.mapFromItem(null, reorderHandler.lastScenePos.x, reorderHandler.lastScenePos.y).y - height / 2 : 0
+    }
+
+    function reorderDrop(scenePos) {
+        const grid = root.visibleLayout;
+        const draggedId = model.itemId;
+        if (!grid || grid.count === 0 || !draggedId) {
+            return;
+        }
+        // Target cell from grid geometry; positions clamped into the grid, so a
+        // release outside it maps to the nearest edge cell. indexAt() operates on
+        // laid-out cell positions, so vertical panels, multi-row grids and
+        // reverseIconOrder (LayoutMirroring) are all handled by the view itself.
+        const pos = grid.mapFromItem(null, scenePos.x, scenePos.y);
+        const cx = Math.max(0, Math.min(grid.width - 1, pos.x)) + grid.contentX;
+        const cy = Math.max(0, Math.min(grid.height - 1, pos.y)) + grid.contentY;
+        let target = grid.indexAt(cx, cy);
+        const ids = [];
+        for (let i = 0; i < grid.count; ++i) {
+            const loader = grid.itemAtIndex(i);
+            if (!loader || !loader.item || !loader.item.model.itemId) {
+                return; // view not fully instantiated; don't write a partial order
+            }
+            ids.push(loader.item.model.itemId);
+        }
+        if (target < 0 || target >= ids.length) {
+            target = ids.length - 1; // released on an empty cell or past the end
+        }
+        const from = ids.indexOf(draggedId);
+        if (from < 0 || from === target) {
+            return;
+        }
+        ids.splice(from, 1);
+        ids.splice(target, 0, draggedId);
+        Plasmoid.configuration.itemOrder = ids;
+        // Save now instead of waiting for the deferred applet config sync,
+        // so the C++ sort model (which listens for KConfigLoader::configChanged)
+        // applies the new order immediately.
+        Plasmoid.configuration.writeConfig();
+    }
+
