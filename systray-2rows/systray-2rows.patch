diff --color -ruN a/applets/systemtray/main.xml b/applets/systemtray/main.xml
--- a/applets/systemtray/main.xml	2026-07-11 19:30:10.448194018 +0300
+++ b/applets/systemtray/main.xml	2026-07-11 19:30:36.553905900 +0300
@@ -37,6 +37,10 @@
       <label>Whether to automatically scale System Tray icons to fix the available thickness of the panel. If false, tray icons will be capped at the smallMedium size (22px) and become a two-row/column layout when the panel is thick.</label>
       <default>false</default>
     </entry>
+    <entry name="useVerySmallIcons" type="bool">
+      <label>Whether to cap panel System Tray icons at the small size (16px) instead of smallMedium (22px) when not scaling icons to fit. Allows additional icon rows/columns in the same panel thickness.</label>
+      <default>false</default>
+    </entry>
     <entry name="iconSpacing" type="int">
       <label>spacing between icons, determined by this number multiplied by Kirigami.Units.smallSpacing</label>
       <default>2</default>
diff --color -ruN a/applets/systemtray/qml/ConfigGeneral.qml b/applets/systemtray/qml/ConfigGeneral.qml
--- a/applets/systemtray/qml/ConfigGeneral.qml	2026-07-11 19:30:10.451491633 +0300
+++ b/applets/systemtray/qml/ConfigGeneral.qml	2026-07-11 19:31:20.144492264 +0300
@@ -30,6 +30,7 @@
     property bool unsavedChanges: !(changedVisibility.size === 0 && changedShortcuts.size === 0)
 
     property bool cfg_scaleIconsToFit
